NEXT_PUBLIC_CSP_MODE=analytics
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id
NEXT_PUBLIC_UMAMI_URL=https://your-umami-instance.railway.app/script.js

# Cross-origin worker configuration (Phase 3, AC-1.2.6)
# Empty (default): workers load from bundled relative paths — use for local dev and analytics-mode builds.
# Set to subdomain origin: workers load cross-origin, enabling Wasm in AdSense CSP mode without wasm-unsafe-eval on the main page.
NEXT_PUBLIC_WORKERS_ORIGIN=
# NEXT_PUBLIC_WORKERS_ORIGIN=https://workers.calculatetokens.com  # adsense production build

# Ad provider: carbon | adsense | ab | (empty = no ads shown)
NEXT_PUBLIC_AD_PROVIDER=

# Carbon Ads serve ID (required when NEXT_PUBLIC_AD_PROVIDER=carbon or ab)
NEXT_PUBLIC_CARBON_SERVE_ID=
